{
  "validation": {
    "commands": [
      "pnpm build",
      "pnpm lint",
      "pnpm typecheck",
      "pnpm test",
      "pnpm test:bash",
      "pnpm boundaries"
    ],
    "tiers": [
      ["pnpm build"],
      ["pnpm lint", "pnpm typecheck", "pnpm test", "pnpm test:bash", "pnpm boundaries"]
    ],
    "timeout": 600,
    "forbiddenArtifactPaths": ["certification/"],
    "narrowByChangedFiles": true
  },
  "phases": {
    "skip": [],
    "reviewConvergence": {
      "maxIterations": 4
    },
    "implement": { "exemptUndeclaredFiles": [] },
    "fixValidate": { "maxIterations": 2 },
    "architectureReview": { "maxCorrections": 2 }
  },
  "timeouts": {
    "readyMaxDays": 7,
    "invocationMaxMinutes": 30
  },
  "taskSplitting": {
    "maxTestFileLines": 500,
    "maxTestCases": 10,
    "blockOversizedTasks": false
  },
  "scheduler": {
    "globalConcurrency": 1,
    "pollIntervalMs": 2000
  },
  "agent": {
    "defaultProfile": "builder",
    "profiles": {
      "architect": {
        "runtime": "opencode",
        "provider": "zai-coding-plan",
        "model": "glm-5.1",
        "timeoutMinutes": 30
      },
      "senior": {
        "runtime": "opencode",
        "provider": "ollama-cloud",
        "model": "glm-5.1",
        "timeoutMinutes": 30
      },
      "builder": {
        "runtime": "opencode",
        "provider": "minimax-coding-plan",
        "model": "MiniMax-M2.7",
        "timeoutMinutes": 30
      },
      "junior": {
        "runtime": "opencode",
        "provider": "opencode",
        "model": "deepseek-v4-flash-free",
        "timeoutMinutes": 30
      },
      "reviewer": {
        "runtime": "antigravity",
        "provider": "google",
        "model": "gemini-3.5-flash-high",
        "timeoutMinutes": 30
      },
      "task-reviewer": {
        "runtime": "antigravity",
        "provider": "google",
        "model": "gemini-3.5-flash-low",
        "timeoutMinutes": 30
      },
      "local": {
        "runtime": "pi",
        "provider": "crofai",
        "model": "qwen3.6-27b",
        "contextLimitTokens": 64000,
        "promptBudgetTokens": 40000,
        "outputBudgetTokens": 8000,
        "timeoutMinutes": 30
      },
      "qwen": {
        "runtime": "opencode",
        "provider": "crofai",
        "model": "qwen3.6-27b",
        "timeoutMinutes": 30
      },
      "claude": {
        "runtime": "claude-code",
        "provider": "anthropic",
        "model": "opus",
        "timeoutMinutes": 30
      },
      "gemini": {
        "runtime": "antigravity",
        "provider": "google",
        "model": "gemini-3.5-flash-high",
        "timeoutMinutes": 30
      },
      "minimax": {
        "runtime": "opencode",
        "provider": "minimax-coding-plan",
        "model": "MiniMax-M3",
        "timeoutMinutes": 30
      },
      "glm": {
        "runtime": "opencode",
        "provider": "ollama-cloud",
        "model": "glm-5.1",
        "timeoutMinutes": 30
      },
      "deepseek": {
        "runtime": "opencode",
        "provider": "ollama-cloud",
        "model": "deepseek-v4-pro",
        "timeoutMinutes": 30
      },
      "mimo-pro": {
        "runtime": "opencode",
        "provider": "opencode-go",
        "model": "mimo-v2.5-pro",
        "timeoutMinutes": 30
      },
      "mimo": {
        "runtime": "opencode",
        "provider": "opencode",
        "model": "mimo-v2.5-free",
        "timeoutMinutes": 30
      },
      "codex-reviewer": {
        "runtime": "codex",
        "provider": "openai",
        "model": "default",
        "timeoutMinutes": 45
      },
      "codex-writer": {
        "runtime": "codex",
        "provider": "openai",
        "model": "default",
        "timeoutMinutes": 45
      }
    },
    "roles": {
      "planner": { "profile": "architect", "fallback": "senior" },
      "implementer": { "profile": "qwen", "fallback": "builder" },
      "fixer": { "profile": "builder", "fallback": "junior" },
      "critic": { "profile": "task-reviewer", "fallback": "junior" },
      "task-agent": { "profile": "junior", "fallback": "builder" },
      "pr-reviewer": { "profile": "gemini", "fallback": "junior" }
    },
    "phaseProfiles": {
      "plan-design": { "role": "planner" },
      "architecture-review": { "role": "pr-reviewer" },
      "architecture-fix": { "role": "planner" },
      "implement": { "role": "implementer" },
      "quality-review": { "role": "critic" },
      "spec-review": {
        "role": "critic",
        "fallbackProfile": "codex-reviewer",
        "fallbackTriggers": ["timeout", "quota_exceeded", "runtime_error"]
      },
      "follow-up-review": { "role": "critic" },
      "fix-review": { "role": "fixer" },
      "fix-validate": { "role": "fixer" },
      "compound": { "role": "task-agent" },
      "create-pr": { "role": "task-agent" },
      "result-writer": { "role": "critic" }
    }
  }
}
